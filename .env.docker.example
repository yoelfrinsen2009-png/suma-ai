# Versi image dipin agar n8n dan task runner selalu kompatibel.
COMPOSE_PROJECT_NAME=suma-ai
N8N_VERSION=2.31.7

# Port lokal. Editor n8n hanya di-bind ke localhost secara default.
APP_BIND_ADDRESS=127.0.0.1
APP_PORT=8080
N8N_BIND_ADDRESS=127.0.0.1
N8N_PORT=5678

# PostgreSQL dan kunci n8n. Script setup akan mengisi nilai kosong ini.
POSTGRES_DB=n8n
POSTGRES_USER=n8n
POSTGRES_PASSWORD=
N8N_ENCRYPTION_KEY=
N8N_RUNNERS_AUTH_TOKEN=

# Konfigurasi lokal. Untuk produksi, gunakan HTTPS dan domain publik.
TZ=Asia/Jakarta
GENERIC_TIMEZONE=Asia/Jakarta
N8N_HOST=localhost
N8N_PROTOCOL=http
N8N_EDITOR_BASE_URL=http://localhost:5678/
N8N_WEBHOOK_URL=http://localhost:8080/
N8N_PROXY_HOPS=1
N8N_SECURE_COOKIE=false
EXECUTIONS_DATA_MAX_AGE=168

# Nilai VITE_* ditanam saat image frontend dibangun.
VITE_N8N_WEBHOOK_URL=http://localhost:8080/webhook/sum-ai-copilot-google-sheets-ollama-v1
# Harus sama dengan companyId pada node "Workflow Configuration" di n8n.
VITE_SUMAI_COMPANY_ID=COMPANY-001
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
VITE_FIREBASE_MEASUREMENT_ID=
