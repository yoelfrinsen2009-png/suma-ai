{
  "name": "sum-ai-copilot-vue-firebase",
  "version": "2.0.0",
  "type": "module",
  "private": true,
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "dev": "vite",
    "build": "vue-tsc --noEmit && node scripts/clean-dist.mjs && vite build",
    "preview": "vite preview",
    "lint": "eslint .",
    "test": "node --experimental-strip-types --test tests/*.test.mjs",
    "check": "npm run lint && npm test && npm run build",
    "firebase:deploy": "npm run build && npx firebase-tools@latest deploy --only hosting,firestore:rules,firestore:indexes --project sumai-bb116",
    "firebase:rules": "npx firebase-tools@latest deploy --only firestore:rules,firestore:indexes --project sumai-bb116"
  },
  "dependencies": {
    "firebase": "^12.16.0",
    "mammoth": "^1.12.0",
    "read-excel-file": "^9.3.4",
    "vue": "^3.5.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.0.0",
    "@types/node": "^22.0.0",
    "@vitejs/plugin-vue": "latest",
    "eslint": "^9.0.0",
    "eslint-plugin-vue": "latest",
    "globals": "latest",
    "typescript": "^5.9.0",
    "typescript-eslint": "latest",
    "vite": "latest",
    "vue-tsc": "latest"
  }
}
